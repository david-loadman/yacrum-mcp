  "description": "MCP server for Yacrum CRM: lets Claude and other MCP clients search, create and summarise CRM records through the Yacrum API.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david-loadman/yacrum-mcp.git"
  },
  "keywords": [
